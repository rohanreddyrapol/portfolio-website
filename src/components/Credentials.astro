---
import { certifications } from '../data/resume';
---
<section id="credentials" class="section-alt section-block">
  <div class="section-shell">
    <div class="section-heading heading-row" data-reveal>
      <div><p class="eyebrow">05 / Credentials</p><h2>Learning with <span class="gradient-text">purpose.</span></h2></div>
      <p class="section-aside">A selection of learning programs and credentials across cloud, risk, data, and business tools.</p>
    </div>
    <div class="credentials-grid">
      {certifications.map((item, index) => <article class="credential-card" data-reveal>
        <div class="credential-card-top"><span class="credential-logo-tile"><img src={item.logo} alt="" aria-hidden="true" loading="lazy" /></span><span class="credential-index">0{index + 1}</span></div>
        <div class="credential-card-content"><p class="eyebrow">{item.organization}</p><h3>{item.title}</h3><p class="credential-date">{item.date}</p>
          {item.url && <a class="credential-link" href={item.url} target="_blank" rel="noreferrer">{item.organization === 'PwC' ? 'View certificate' : 'View verified badge'} <span aria-hidden="true">↗</span></a>}
        </div>
      </article>)}
    </div>
  </div>
</section>
